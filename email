REM === Extract EXE version and write to Version.TXT ===
set "exePath=%folder%\Cammis.Surge.Client.exe"
set "versionFile=%folder%\Version.TXT"

echo Checking EXE version and writing to Version.TXT...
powershell -Command "(Get-Item '%exePath%').VersionInfo.FileVersion | Out-File '%versionFile%' -Encoding ascii"

if exist "%versionFile%" (
    echo Version successfully written:
    type "%versionFile%"
) else (
    echo ERROR: Failed to update Version.TXT
)

echo Deployment complete.
endlocal
